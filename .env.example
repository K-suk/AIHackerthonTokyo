# 音声→テキスト / テキスト→注文
AQUA_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase（Postgres）への接続。サーバ専用（NEXT_PUBLIC_ は付けない）。
# 接続プーラーのトランザクションモード（ポート6543）の接続文字列を推奨。
DATABASE_URL=

# 日報（Phase 6）
REPORT_TO_EMAIL=
STORE_NAME=声レジカフェ

# 店舗共通パスコード認証（Phase 9・時間があれば）
# STORE_PASSCODE_HASH は `npm run hash-passcode -- <パスコード>` で生成する。
STORE_PASSCODE_HASH=
SESSION_SECRET=
STAFF_NAMES=田中,佐藤,鈴木
